# Ignore generated log files upon CUDA compilation
*.tlog
*.user
*_imgui.ini
mode/android/*
mode/linux/*
mode/mac/*
mode/platform010/*
mode/win/*
mode/dbg*
mode/dev*
mode/opt
mode/cuda/dbg*
mode/cuda/dev*
mode/cuda/opt
build*
# ...but not the checked-in wheel/asset build drivers, which `build*` matches by accident.
!tools/build_wheels.py
!tools/build_16dof_superdex_bot.py
ref
*.local.cmake
cmake-build*
.idea
.polyscope.ini
CMakeUserPresets.json
imgui.ini
SuperDexStudio.ini
*.recording.h5
*.state.h5
audit_reports/
default.profraw
*.egg-info/

# Python bytecode and local asset archives
__pycache__/
*.py[cod]
/assets/*.zip
/assets/**/*.zip
/hardware/*.zip
sharpa_teleop/.pixi/
sharpa_teleop/.cache/
sharpa_teleop/recordings/*.jsonl
